{
  "name": "forward-first",
  "version": "0.1.0",
  "private": true,
  "description": "Forward First: an interactive learning tool for FX as one offline HTML file, from spot and forwards to options, the Greeks and structured products.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/build-offline.ts",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "e2e": "playwright test -c playwright.offline.config.ts",
    "data:fetch": "tsx scripts/fetch-ecb.ts",
    "data:build": "tsx scripts/build-riskometer.ts",
    "data:mc": "tsx scripts/precompute-mc.ts",
    "build:web": "astro build",
    "build:offline": "tsx scripts/build-offline.ts",
    "e2e:web": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/preact": "6.1.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/stix-two-text": "5.3.0",
    "astro": "7.4.2",
    "fflate": "0.8.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/regexpp": "4.12.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
