{
  // Cloudflare Workers with Static Assets: serves dist/ as a static site, no Worker code.
  // See DECISIONS.md D-13 and README.md "Deploy".
  "name": "forward-first",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
