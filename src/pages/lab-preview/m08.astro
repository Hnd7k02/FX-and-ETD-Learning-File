---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PathSimulatorFigure from '@/components/figures/PathSimulatorFigure.astro';
import DciCalculatorFigure from '@/components/figures/DciCalculatorFigure.astro';
---

<BaseLayout lang="de" title="Preview" family="exotics">
  <main class="container-module" style="padding-top:32px;padding-bottom:64px">
    <article class="prose">
      <DciCalculatorFigure caption="dci" />
      <PathSimulatorFigure products={['accumulator', 'decumulator']} scenario="trendDown" caption="acc" />
      <PathSimulatorFigure products={['tarf', 'pivotTarf']} scenario="shock" gapDay={20} gap={-0.1} caption="tarf" />
    </article>
  </main>
</BaseLayout>
