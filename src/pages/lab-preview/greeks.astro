---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GreeksLabFigure from '@/components/figures/GreeksLabFigure.astro';
---

<BaseLayout lang="de" title="Preview" family="options">
  <main class="container-module" style="padding-top:32px;padding-bottom:64px">
    <article class="prose">
      <GreeksLabFigure mode="delta-gamma" caption="delta-gamma" />
      <GreeksLabFigure mode="vega" caption="vega" />
      <GreeksLabFigure mode="theta" caption="theta" />
      <GreeksLabFigure mode="rho" caption="rho" />
    </article>
  </main>
</BaseLayout>
