---
interface Props {
  color?: string;
  dir?: 'right' | 'left';
}
const { color = '#FFFFFF', dir = 'right' } = Astro.props;
---

<svg
  width="14"
  height="14"
  viewBox="0 0 14 14"
  aria-hidden="true"
  style={dir === 'left' ? 'transform:scaleX(-1)' : undefined}
>
  <path
    d="M2 7H12M8 3L12 7L8 11"
    style={`fill:none;stroke:${color};stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round`}
  ></path>
</svg>
