---
/** Hockey-stick glyph: the payoff of a call option. */
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
const glyph = Math.round(size * 0.56);
---

<span
  class="logo-mark"
  style={`width:${size}px;height:${size}px;flex-basis:${size}px`}
  aria-hidden="true"
>
  <svg width={glyph} height={glyph} viewBox="0 0 20 20">
    <path d="M3 14.5H9.5L17 5"></path>
  </svg>
</span>

<style>
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border-radius: 11px;
    background: var(--ff-ink);
  }
  path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
