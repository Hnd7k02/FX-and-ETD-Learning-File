---
/**
 * Hedge comparison (module 09, section 2) for MDX.
 *
 * Props (all optional)
 * - show?: string[]  Strategies visible first: unhedged, forward, call, collar, leveraged
 *                    (default all five).
 * - st?: number      USD/CHF at expiry marked first (default spot + 4 %, M09_CONFIG.hedge).
 * - caption?: string
 *
 * Example: <HedgeCompareFigure caption="…" />
 */
import HedgeCompare from '@/components/islands/HedgeCompare';
import Figure from '@/components/content/Figure.astro';
import { pageLang } from '@/components/content/lang';

interface Props {
  show?: string[];
  st?: number;
  caption?: string;
}
const { caption, ...rest } = Astro.props;
const lang = pageLang(Astro.currentLocale);
---

<Figure caption={caption}>
  <HedgeCompare client:visible lang={lang} {...rest} />
</Figure>

<style is:global>
  .hc {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    color: var(--ff-ink);
  }
  .hc p {
    margin: 0;
  }
  .hc .ff-lab-head {
    margin-bottom: 0;
  }
  .hc-head-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hc-lead {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: var(--ff-r-pill);
    background: var(--ff-good-soft);
    color: var(--ff-good-text-strong);
    font-size: 13px;
    font-weight: 800;
    animation: hc-pop 420ms cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
  }

  .hc-toggles {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }
  .hc-toggle {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-height: 56px;
    padding: 8px 10px;
    border: 1px solid var(--ff-line-input);
    border-radius: 14px;
    background: var(--ff-surface);
    color: var(--ff-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }
  .hc-toggle svg {
    flex: 0 0 auto;
    margin-top: 5px;
  }
  .hc-toggle:hover {
    border-color: var(--ff-ref);
  }
  .hc-toggle[aria-pressed='true'] {
    border-color: var(--ff-ink);
    background: var(--ff-surface-2);
  }
  .hc-toggle[aria-pressed='false'] svg {
    opacity: 0.35;
  }
  .hc-toggle-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .hc-toggle-name {
    font-size: 13px;
    font-weight: 800;
  }
  .hc-toggle-key {
    font-size: 11px;
    line-height: 1.35;
    color: var(--ff-muted);
  }
  .hc-toggle[aria-pressed='false'] .hc-toggle-name {
    color: var(--ff-ink-2);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .hc-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--ff-font-ui);
    user-select: none;
    -webkit-user-select: none;
  }
  .hc-line[pathLength] {
    stroke-dasharray: 1;
    animation: hc-draw 600ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .hc-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: hc-ring 900ms ease-out both;
  }
  .hc-note,
  .hc-note-text {
    animation: hc-in 320ms ease-out both;
  }
  .hc .hc-note-text {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.45;
  }
  .hc-handle {
    cursor: grab;
    touch-action: none;
  }
  .hc-handle.is-active {
    cursor: grabbing;
  }
  .hc .hc-hint {
    font-size: 12px;
    color: var(--ff-muted);
  }

  .hc-rank {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ff-line);
    border-radius: var(--ff-r-box);
    overflow: hidden;
    background: var(--ff-surface);
  }
  .hc-rank-head {
    padding: 10px 16px;
    background: var(--ff-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .hc .hc-rank-list {
    position: relative;
    display: block;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hc .hc-row {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 58px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    border-top: 1px solid var(--ff-row);
    background: var(--ff-surface);
    font-size: 14px;
    line-height: 1.3;
    transition: transform 300ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .hc .hc-rank-list.is-live .hc-row {
    transition: none;
  }
  .hc .hc-row.is-best {
    background: var(--ff-good-soft);
  }
  .hc-row-pos {
    flex: 0 0 auto;
    width: 18px;
    font-size: 13px;
    color: var(--ff-muted);
  }
  .hc-row-swatch {
    flex: 0 0 auto;
    width: 4px;
    height: 30px;
    border-radius: 2px;
  }
  .hc-row-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .hc-row-name {
    font-weight: 800;
  }
  .hc-row-nums {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1px;
    flex: 0 0 auto;
  }
  .hc-row-sub {
    font-size: 12px;
    color: var(--ff-muted);
    white-space: nowrap;
  }
  .hc-row.is-best .hc-row-sub {
    color: var(--ff-good-text-strong);
  }
  .hc-row-value {
    font-size: 14px;
    white-space: nowrap;
  }
  .hc-tag {
    display: inline-flex;
    padding: 1px 8px;
    border-radius: var(--ff-r-pill);
    background: var(--ff-good-text);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
  }
  .hc-play {
    align-self: flex-start;
  }
  .hc-icon-fill {
    fill: currentColor;
  }
  .hc-icon-stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
  }

  @media (max-width: 900px) {
    .hc-toggles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .hc-toggles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hc-toggle {
      min-height: 44px;
      align-items: center;
    }
    .hc-toggle svg {
      margin-top: 0;
    }
    .hc-toggle-key {
      display: none;
    }
    .hc .hc-row {
      padding: 0 12px;
      gap: 8px;
    }
  }

  @keyframes hc-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hc-ring {
    from {
      transform: scale(0.4);
      stroke-width: 4;
    }
    to {
      transform: scale(1);
      stroke-width: 1.5;
    }
  }
  @keyframes hc-in {
    from {
      transform: translateY(4px);
    }
    to {
      transform: none;
    }
  }
  @keyframes hc-pop {
    0% {
      transform: scale(0.85);
    }
    70% {
      transform: scale(1.04);
    }
    100% {
      transform: none;
    }
  }
</style>
