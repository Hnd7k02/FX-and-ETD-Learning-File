---
/**
 * Building blocks of a structured product as an MDX figure (module 08).
 *
 * Props (all optional)
 * - products?: string[]  Product kinds: accumulator, decumulator, tarf (with the three-step
 *                        story), pivotTarf, tpf, rtpf (blocks only). Default ['accumulator'].
 * - initial?: string     Product shown first.
 * - step?: number        First story step 1 (forward), 2 (double amount), 3 (knock-out/target).
 * - autoplay?: boolean   Play the story once when visible (default true; never with reduced
 *                        motion).
 * - fixing?: number      Initial fixing of the readout marker (default 5 % below spot).
 * - caption?: string     Figure caption.
 */
import Figure from '@/components/content/Figure.astro';
import StructureBlocks from '@/components/islands/StructureBlocks';
import { pageLang } from '@/components/content/lang';

interface Props {
  products?: string[];
  initial?: string;
  step?: number;
  autoplay?: boolean;
  fixing?: number;
  caption?: string;
}
const { caption, ...rest } = Astro.props;
const lang = pageLang(Astro.currentLocale);
---

<Figure caption={caption}>
  <StructureBlocks client:visible lang={lang} {...rest} />
</Figure>

<style is:global>
  .sb {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    color: var(--ff-ink);
  }
  .sb p {
    margin: 0;
  }
  .sb .ff-lab-head {
    margin-bottom: 0;
  }
  .sb-head-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .sb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sb-chip {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--ff-line-input);
    border-radius: var(--ff-r-pill);
    background: var(--ff-surface);
    color: var(--ff-ink-2);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .sb-chip[aria-pressed='true'] {
    background: var(--ff-ink);
    border-color: var(--ff-ink);
    color: #fff;
  }
  .sb-steps-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
  }
  .sb-round {
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border: 0;
    border-radius: 999px;
    background: var(--ff-ink);
    color: #fff;
    cursor: pointer;
  }
  .sb-icon-stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .sb-icon-fill {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .sb .sb-steps {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sb .sb-steps li {
    font-size: inherit;
    line-height: inherit;
  }
  .sb-step {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 56px;
    padding: 8px 12px;
    border: 1px solid var(--ff-line-input);
    border-radius: var(--ff-r-box);
    background: var(--ff-surface);
    color: var(--ff-ink-2);
    text-align: left;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .sb-step[aria-pressed='true'] {
    border-color: var(--ff-exotics);
    background: var(--ff-exotics-soft);
    color: var(--ff-ink);
  }
  .sb-step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex: 0 0 26px;
    border-radius: 999px;
    background: var(--ff-chip);
    font-size: 12px;
    font-weight: 800;
  }
  .sb-step[aria-pressed='true'] .sb-step-n {
    background: var(--ff-exotics-text);
    color: #fff;
  }
  .sb-step-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sb-step-label {
    font-size: 13px;
    font-weight: 800;
  }
  .sb-step-value {
    font-size: 12px;
    color: var(--ff-ink-2);
    overflow-wrap: anywhere;
  }
  .sb-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--ff-exotics);
    transform-origin: left;
    animation: sb-progress 4200ms linear both;
  }
  @keyframes sb-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .sb .sb-text {
    min-height: 3.2em;
    max-width: 780px;
    font-size: 15px;
    line-height: 1.55;
    font-weight: 600;
    color: var(--ff-ink);
    animation: sb-in 320ms ease-out both;
  }
  @keyframes sb-in {
    from {
      transform: translateY(4px);
    }
    to {
      transform: none;
    }
  }
  .sb-legend-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .sb .ff-legend {
    flex-direction: row;
    padding: 0;
    gap: 6px 18px;
  }
  .sb .ff-legend li {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ff-ink-2);
  }
  .sb-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ff-ink-2);
    cursor: pointer;
  }
  .sb-toggle input {
    width: 18px;
    height: 18px;
    accent-color: var(--ff-ink);
  }
  .sb-chart {
    width: 100%;
  }
  .sb-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--ff-font-ui);
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
  }
  .sb-svg text {
    pointer-events: none;
  }
  .sb-axis-title {
    font-weight: 600;
    fill: var(--ff-muted);
  }
  .sb-ko {
    fill: rgba(14, 17, 22, 0.05);
  }
  .sb-ko-label {
    font-weight: 700;
    fill: var(--ff-ink-2);
  }
  .sb-target {
    fill: none;
    stroke: var(--ff-exotics);
    stroke-width: 1.25;
    stroke-dasharray: 2 4;
  }
  .sb-target-label {
    font-weight: 700;
    fill: var(--ff-exotics-text);
  }
  .sb-forward {
    fill: none;
    stroke: var(--ff-ref);
    stroke-width: 1.75;
    stroke-dasharray: 6 6;
  }
  .sb-block {
    fill: none;
    stroke-width: 6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .sb-block--long {
    stroke: rgba(37, 99, 235, 0.32);
  }
  .sb-block--short {
    stroke: rgba(234, 88, 12, 0.36);
  }
  .sb-block-label {
    font-weight: 700;
  }
  .sb-block-label--long {
    fill: var(--ff-linear-text);
  }
  .sb-block-label--short {
    fill: var(--ff-exotics-text);
  }
  .sb-product {
    fill: none;
    stroke: var(--ff-forward);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .sb-ref {
    fill: none;
    stroke: var(--ff-ref);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }
  .sb-ref--fwd {
    stroke: var(--ff-axis);
  }
  .sb-pill {
    fill: var(--ff-ink);
  }
  .sb-pill--fwd {
    fill: #fff;
    stroke: var(--ff-line-strong);
  }
  .sb-pill-text {
    font-family: var(--ff-font-mono);
    font-weight: 600;
    fill: var(--ff-ink-2);
  }
  .sb-pill-text--k {
    fill: #fff;
  }
  .sb-marker-line {
    fill: none;
    stroke: var(--ff-ink);
    stroke-width: 1;
    stroke-opacity: 0.4;
    stroke-dasharray: 2 3;
  }
  .sb-dot {
    fill: var(--ff-forward);
    stroke: #fff;
    stroke-width: 2.5;
  }
  .sb-dot-fwd {
    fill: #fff;
    stroke: var(--ff-ref);
    stroke-width: 2;
  }
  .sb .sb-readout {
    min-height: 1.5em;
    font-size: 14px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--ff-ink-2);
  }
  .sb-fixing {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 6px 16px;
  }
  .sb-fixing .ff-slider {
    flex: 1 1 260px;
    max-width: 420px;
  }
  .sb-hint {
    font-size: 12px;
    color: var(--ff-muted);
    padding-bottom: 6px;
  }
  @media (max-width: 640px) {
    .sb-steps-row {
      flex-direction: column;
      align-items: stretch;
    }
    .sb-round {
      align-self: flex-start;
    }
    .sb .sb-steps {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sb .sb-text,
    .sb-progress,
    .sb-step {
      animation: none;
      transition: none;
    }
  }
</style>
