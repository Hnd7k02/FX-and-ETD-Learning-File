---
/**
 * ForwardCurve as an MDX figure (module 02, section 3): <ForwardCurveFigure caption="…" />.
 * Reads the page language and hydrates the island when it scrolls into view.
 */
import Figure from '@/components/content/Figure.astro';
import ForwardCurve from '@/components/islands/ForwardCurve';
import { pageLang } from '@/components/content/lang';
import M02Styles from './M02Styles.astro';

interface Props {
  caption?: string;
}
const { caption } = Astro.props;
const lang = pageLang(Astro.currentLocale);
---

<M02Styles />
<Figure caption={caption}>
  <ForwardCurve client:visible lang={lang} />
</Figure>
