---
/** "Five levers" figure for module 05, section 1: <GreeksLeversFigure caption="…" />. */
import Figure from '@/components/content/Figure.astro';
import GreeksLevers from '@/components/islands/GreeksLevers';
import { pageLang } from '@/components/content/lang';

interface Props {
  caption?: string;
}
const { caption } = Astro.props;
const lang = pageLang(Astro.currentLocale);
---

<Figure caption={caption}>
  <GreeksLevers client:visible lang={lang} />
</Figure>

<style is:global>
  .glv {
    color: var(--ff-ink);
  }
  .glv .ff-lab-head {
    margin-bottom: 18px;
  }
  .glv-titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    max-width: 560px;
  }
  .glv-premium {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--ff-r-pill);
    background: var(--ff-ink);
    color: var(--ff-on-dark-muted);
    font-size: 13px;
  }
  .glv-premium b {
    color: #fff;
    font-weight: 800;
    font-size: 15px;
  }
  .glv-rows {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ff-line);
    border-radius: var(--ff-r-box);
    overflow: hidden;
  }
  .glv-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'name ctrl'
      'bar value'
      'foot foot';
    align-items: center;
    gap: 8px 16px;
    padding: 14px 16px;
    border-top: 1px solid var(--ff-row);
  }
  .glv-row:first-child {
    border-top: 0;
  }
  .glv-name {
    grid-area: name;
  }
  .glv-ctrl {
    grid-area: ctrl;
    justify-self: end;
  }
  .glv-track {
    grid-area: bar;
  }
  .glv-value {
    grid-area: value;
  }
  .glv-foot {
    grid-area: foot;
  }
  @media (max-width: 640px) {
    .glv-row {
      grid-template-areas:
        'name value'
        'ctrl ctrl'
        'bar bar'
        'foot foot';
      padding: 12px;
    }
    .glv-ctrl {
      justify-self: start;
    }
  }
  .glv-name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 800;
  }
  .glv-sym {
    display: inline-block;
    text-align: center;
    min-width: 40px;
    padding: 3px 8px;
    border-radius: var(--ff-r-pill);
    background: var(--ff-options-soft);
    color: var(--ff-options-text);
    font-family: var(--ff-font-math);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.1;
  }
  .glv-sym sub {
    font-size: 11px;
  }
  .glv .segmented > button {
    min-height: 44px;
  }
  .glv-track {
    position: relative;
    min-width: 0;
    height: 14px;
    border-radius: 999px;
    background: var(--ff-surface-2);
  }
  .glv-zero {
    position: absolute;
    left: 50%;
    top: -4px;
    bottom: -4px;
    width: 1px;
    background: var(--ff-axis);
  }
  .glv-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
  }
  .glv-bar.is-up {
    background: var(--ff-good);
  }
  .glv-bar.is-down {
    background: var(--ff-bad);
  }
  .glv-value {
    min-width: 128px;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--ff-font-mono);
    font-weight: 600;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .glv-value small {
    font-family: var(--ff-font-ui);
    font-size: 12px;
    font-weight: 700;
  }
  .glv-value.is-up {
    color: var(--ff-good-text);
  }
  .glv-value.is-down {
    color: var(--ff-bad-text);
  }
  .glv-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    font-size: 13px;
    line-height: 1.45;
  }
  .glv-why {
    color: var(--ff-ink-2);
    flex: 1 1 280px;
  }
  .glv-est {
    color: var(--ff-muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .glv-value {
      min-width: 0;
      font-size: 14px;
    }
  }
</style>
