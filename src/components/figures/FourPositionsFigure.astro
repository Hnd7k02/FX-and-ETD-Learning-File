---
/**
 * The four basic positions as a labelled 2 × 2 sketch (module 04, section 2): P&L at expiry
 * after the premium for long/short call and put at the example strike, with right or
 * obligation, premium direction, maximum gain and loss. Static (no island); maths from
 * src/lib/payoff.ts, strings from src/i18n/dict/m04.ts (fp.*). Props: caption.
 */
import Figure from '@/components/content/Figure.astro';
import { pageLang } from '@/components/content/lang';
import { m04 } from '@/i18n/dict/m04';
import { translator } from '@/i18n/types';
import { EXAMPLE } from '@/lib/fx/example';
import { linePath, scaleLinear, type Point } from '@/lib/chart';
import { fmtRate } from '@/lib/format';
import {
  breakEvens,
  buildTemplate,
  pnlAtExpiry,
  templateStrikes,
  type PayoffMarket,
} from '@/lib/payoff';

interface Props {
  caption?: string;
}
const { caption } = Astro.props;
const lang = pageLang(Astro.currentLocale);
const t = translator(m04, lang);

const M: PayoffMarket = {
  S: EXAMPLE.spot,
  T: EXAMPLE.T,
  vol: EXAMPLE.vol,
  rd: EXAMPLE.rd,
  rf: EXAMPLE.rf,
  notional: EXAMPLE.notional,
  pair: EXAMPLE.pair,
};
const K = templateStrikes(M).atmf;
const W = 220;
const H = 96;
const X: [number, number] = [K - 0.045, K + 0.045];
const sx = scaleLinear(X, [8, W - 8]);
const ids = ['long-call', 'short-call', 'long-put', 'short-put'] as const;
type Id = (typeof ids)[number];

const curves = ids.map((id) => {
  const legs = buildTemplate(id, M).legs;
  const xs = Array.from({ length: 61 }, (_, i) => X[0] + ((X[1] - X[0]) * i) / 60);
  const be = breakEvens(legs, M)[0] ?? K;
  return { id, ys: xs.map((x) => pnlAtExpiry(legs, M, x) / M.notional), xs, be };
});
const kText = fmtRate(K, M.pair);
const maxAbs = Math.max(...curves.flatMap((c) => c.ys.map(Math.abs)));
const sy = scaleLinear([-maxAbs, maxAbs], [H - 8, 8]);

const facts: Record<Id, { long: boolean; pay: boolean; gain: string; loss: string }> = {
  'long-call': { long: true, pay: true, gain: 'fp.unlimited', loss: 'fp.capPremium' },
  'short-call': { long: false, pay: false, gain: 'fp.capPremium', loss: 'fp.unlimited' },
  'long-put': { long: true, pay: true, gain: 'fp.toZero', loss: 'fp.capPremium' },
  'short-put': { long: false, pay: false, gain: 'fp.capPremium', loss: 'fp.toZero' },
};
type Key = Parameters<typeof t>[0];
---

<Figure caption={caption}>
  <p class="fp-legend">
    {t('fp.legend', { k: kText })}
    <span class="fp-legend-be">
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <circle cx="6" cy="6" r="4" class="fp-be"></circle>
      </svg>
      {t('fp.legendBe')}
    </span>
  </p>
  <div class="fp" data-four-positions>
    {curves.map((c) => {
      const f = facts[c.id];
      const color = f.long ? 'var(--ff-long)' : 'var(--ff-short)';
      const text = f.long ? 'var(--ff-linear-text)' : 'var(--ff-exotics-text)';
      const d = linePath(c.xs.map((x, i): Point => [sx(x), sy(c.ys[i] ?? 0)]));
      const name = t(`fp.${c.id}` as Key);
      return (
        <section class="fp-card" style={`--fp: ${color}; --fp-text: ${text}`} aria-label={name}>
          <div class="fp-head">
            <span class="fp-name">{name}</span>
            <span class="fp-view">
              {t('fp.view')}: {t(`fp.view.${c.id}` as Key)}
            </span>
          </div>
          <svg
            viewBox={`0 0 ${W} ${H}`}
            role="img"
            aria-label={t('fp.aria', { name, k: kText, be: fmtRate(c.be, M.pair) })}
            class="fp-svg"
          >
            <path d={`M8,${sy(0).toFixed(1)}H${W - 8}`} class="fp-zero" />
            <path d={`M${sx(K).toFixed(1)},6V${H - 6}`} class="fp-k" />
            <text x={sx(K) + 4} y={14} class="fp-klabel">
              {t('fp.k')}
            </text>
            <path d={d} class="fp-line" />
            <circle cx={sx(c.be).toFixed(1)} cy={sy(0).toFixed(1)} r="3.5" class="fp-be" />
          </svg>
          <dl class="fp-facts">
            <div>
              <dt class="sr-only">{name}</dt>
              <dd class="fp-right">{t(`fp.right.${c.id}` as Key)}</dd>
            </div>
            <div>
              <dt>{t('fp.premium')}</dt>
              <dd>{t(f.pay ? 'fp.pay' : 'fp.receive')}</dd>
            </div>
            <div>
              <dt>{t('fp.gain')}</dt>
              <dd>{t(f.gain as Key)}</dd>
            </div>
            <div>
              <dt>{t('fp.loss')}</dt>
              <dd>{t(f.loss as Key)}</dd>
            </div>
          </dl>
        </section>
      );
    })}
  </div>
</Figure>

<style>
  .fp {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .fp-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border-radius: var(--ff-r-box);
    background: var(--ff-surface-2);
    border-top: 3px solid var(--fp);
    min-width: 0;
  }
  .fp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
  }
  .fp-name {
    font-size: 17px;
    font-weight: 800;
    color: var(--fp-text);
  }
  .fp-view {
    font-size: 12px;
    color: var(--ff-muted);
  }
  .fp-svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 120px;
    font-family: var(--ff-font-ui);
  }
  .fp-zero {
    stroke: var(--ff-axis);
    stroke-width: 1;
  }
  .fp-k {
    stroke: var(--ff-ref);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }
  .fp-klabel {
    font-size: 11px;
    font-weight: 700;
    fill: var(--ff-ink-2);
  }
  .fp-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ff-ink-2);
  }
  .fp-legend-be {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .fp-be {
    fill: #fff;
    stroke: var(--ff-forward);
    stroke-width: 1.5;
  }
  .fp-line {
    fill: none;
    stroke: var(--fp);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fp-facts {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
  }
  .fp-facts > div {
    display: flex;
    gap: 8px;
  }
  .fp-facts dt {
    flex: 0 0 72px;
    color: var(--ff-muted);
  }
  .fp-facts dd {
    margin: 0;
    color: var(--ff-ink);
    font-weight: 600;
  }
  .fp-facts .fp-right {
    font-weight: 700;
  }
  @media (max-width: 560px) {
    .fp {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
