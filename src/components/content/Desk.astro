---
/** Dark "Am Desk" callout: how practitioners use the concept. */
import { common } from '@/i18n/dict/common';
import { translator } from '@/i18n/types';
import { pageLang } from './lang';

interface Props {
  title: string;
}
const { title } = Astro.props;
const t = translator(common, pageLang(Astro.currentLocale));
const id = `desk-${title
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;
---

<aside class="desk" aria-labelledby={id}>
  <span class="desk-tag">{t('module.desk')}</span>
  <h3 id={id} class="desk-title">
    {title}
  </h3>
  <slot />
</aside>
