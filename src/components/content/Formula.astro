---
/** Formula box (STIX Two Text). variant: plain | accent (family colour) | dark. */
interface Props {
  variant?: 'plain' | 'accent' | 'dark';
  label?: string;
}
const { variant = 'plain', label } = Astro.props;
---

<div
  class:list={[
    'formula',
    variant === 'accent' && 'formula--accent',
    variant === 'dark' && 'formula--dark',
  ]}
  role={label ? 'math' : undefined}
  aria-label={label}
>
  <slot />
</div>
