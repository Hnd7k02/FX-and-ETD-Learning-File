---
/**
 * Home page (B-Home), shared by / (de) and /en/ (en). Everything is rendered statically for
 * "no progress"; the script below updates the progress-dependent parts from localStorage on
 * every astro:page-load (the site uses the ClientRouter).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import WowCard from '@/components/home/WowCard.astro';
import LearningPath from '@/components/home/LearningPath.astro';
import ResumeCard from '@/components/home/ResumeCard.astro';
import RiskCard from '@/components/home/RiskCard.astro';
import { common } from '@/i18n/dict/common';
import { home } from '@/i18n/dict/home';
import { homePath } from '@/i18n/routes';
import { translator, type Lang } from '@/i18n/types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(common, lang);
const th = translator(home, lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
---

<BaseLayout lang={lang} title={t('home.title')} nav="modules" altPath={homePath(other)}>
  <main data-home data-lang={lang}>
    <section class="container hero" aria-labelledby="hero-h">
      <Hero lang={lang} />
      <WowCard lang={lang} />
    </section>

    <LearningPath lang={lang} />

    <section class="container cards" aria-label={th('home.resumeSection')}>
      <ResumeCard lang={lang} />
      <RiskCard lang={lang} />
    </section>
  </main>
</BaseLayout>

<script>
  import { FAMILIES, MODULES } from '@/data/modules';
  import { modulePath, type SectionKey } from '@/i18n/routes';
  import { fill } from '@/i18n/types';
  import { fmtPctValue } from '@/lib/format';
  import {
    CONTENT_SECTIONS,
    doneModules,
    isQuizPassed,
    isSectionDone,
    loadProgress,
    moduleStatus,
    overallPercent,
    resumeTarget,
    type Progress,
  } from '@/lib/progress';

  type Lang = 'de' | 'en';

  /** First open unit of a module: the target of its station. */
  function firstOpenIn(p: Progress, slug: string): SectionKey {
    for (const s of CONTENT_SECTIONS) if (!isSectionDone(p, slug, s)) return s;
    return isQuizPassed(p, slug) ? '1' : 'quiz';
  }

  function setText(el: Element | null, s: string) {
    if (el && el.textContent !== s) el.textContent = s;
  }

  function apply() {
    const root = document.querySelector<HTMLElement>('[data-home]');
    if (!root) return;
    const lang: Lang = root.dataset.lang === 'en' ? 'en' : 'de';
    const p = loadProgress();
    const target = resumeTarget(p);
    const mod = MODULES.find((m) => m.slug === target.slug) ?? MODULES[0]!;
    const href = modulePath(lang, target.slug, target.section);

    // Hero: "Weiter mit 05 Greeks" once something is done, else "Mit 01 Spot starten".
    const cta = root.querySelector<HTMLAnchorElement>('[data-cta]');
    if (cta) {
      cta.href = href;
      setText(
        cta.querySelector('[data-cta-label]'),
        target.started
          ? fill(cta.dataset.tplContinue ?? '', { n: mod.n, title: mod.title[lang] })
          : (cta.dataset.tplStart ?? ''),
      );
    }

    // Learning path header.
    setText(root.querySelector('[data-overall]'), fmtPctValue(overallPercent(p), lang, 0));
    const done = root.querySelector<HTMLElement>('[data-done]');
    if (done) {
      setText(done, fill(done.dataset.tpl ?? '', { done: doneModules(p), total: MODULES.length }));
    }

    // Stations: state, lines, chip, link to the first open section.
    let prevDone = false;
    MODULES.forEach((m, i) => {
      const st = moduleStatus(p, m.slug);
      const el = root.querySelector<HTMLAnchorElement>(`[data-station="${m.slug}"]`);
      if (!el) return;
      el.dataset.state = st.state;
      el.href = modulePath(lang, m.slug, firstOpenIn(p, m.slug));
      if (st.state === 'current') el.setAttribute('aria-current', 'step');
      else el.removeAttribute('aria-current');
      el.dataset.lineL = i === 0 ? 'none' : prevDone ? 'done' : 'open';
      el.dataset.lineR = i === MODULES.length - 1 ? 'none' : st.state === 'done' ? 'done' : 'open';
      const chip = el.querySelector<HTMLElement>('[data-chip]');
      if (chip) {
        chip.hidden = st.state !== 'current';
        setText(chip, fill(chip.dataset.tpl ?? '', { p: st.percent }));
      }
      const sr = el.querySelector<HTMLElement>('[data-state-text]');
      if (sr) setText(sr, st.state === 'done' ? ` · ${sr.dataset.done ?? ''}` : '');
      prevDone = st.state === 'done';
    });

    // "Weiter, wo du warst".
    const card = root.querySelector<HTMLElement>('[data-resume]');
    if (!card) return;
    const d = card.dataset;
    card.dataset.family = mod.family;
    setText(
      card.querySelector('[data-resume-label]'),
      (target.started ? d.tplLabelResume : d.tplLabelStart) ?? '',
    );
    setText(card.querySelector('[data-resume-chip]'), `${mod.n} · ${FAMILIES[mod.family].label[lang]}`);
    const isQuiz = target.section === 'quiz';
    const sec = isQuiz ? null : mod.sections[Number(target.section) - 1]!;
    setText(
      card.querySelector('[data-resume-title]'),
      `${mod.title[lang]}: ${sec ? sec.title[lang] : (d.quizLabel ?? '')}`,
    );
    setText(card.querySelector('[data-resume-teaser]'), sec ? sec.teaser[lang] : (d.quizLead ?? ''));
    card.querySelectorAll<HTMLElement>('[data-pill]').forEach((pill, idx) => {
      const key = pill.dataset.pill as SectionKey;
      const isDone = key === 'quiz' ? isQuizPassed(p, mod.slug) : isSectionDone(p, mod.slug, key);
      const state = isDone ? 'done' : key === target.section ? 'current' : 'open';
      pill.dataset.state = state;
      setText(
        pill.querySelector('[data-pill-label]'),
        key === 'quiz' ? (d.quizLabel ?? '') : mod.sections[idx]!.short[lang],
      );
      setText(
        pill.querySelector('[data-pill-sr]'),
        state === 'done' ? ` · ${d.srDone ?? ''}` : state === 'current' ? ` · ${d.srCurrent ?? ''}` : '',
      );
    });
    const btn = card.querySelector<HTMLAnchorElement>('[data-resume-cta]');
    if (btn) {
      btn.href = href;
      setText(
        btn.querySelector('[data-resume-cta-label]'),
        (target.started ? d.tplCtaResume : d.tplCtaStart) ?? '',
      );
    }
  }

  document.addEventListener('astro:page-load', apply);
</script>

<style>
  .hero {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .cards {
    padding-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: stretch;
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 32px;
      gap: 24px;
    }
    .cards {
      padding-top: 24px;
      gap: 16px;
    }
  }
</style>
