---
/**
 * Module quiz page (/module/{slug}/quiz/ and /en/module/{slug}/quiz/): same header with the
 * stepper on "Quiz", a short intro and the four graded questions (Quiz island, mode "quiz").
 * The island records the result (pass from 3 of 4) and remembers the visit.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ComingSoon from '@/components/module/ComingSoon.astro';
import ModuleHeader from '@/components/module/ModuleHeader.astro';
import ModuleMain from '@/components/module/ModuleMain.astro';
import Pager from '@/components/module/Pager.astro';
import SectionIntro from '@/components/module/SectionIntro.astro';
import Quiz from '@/components/islands/Quiz';
import { getQuiz, viewQuestion } from '@/content/quiz';
import { getModule } from '@/data/modules';
import { common } from '@/i18n/dict/common';
import { modulePath, SECTION_KEYS } from '@/i18n/routes';
import { translator, type Lang } from '@/i18n/types';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = translator(common, lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const m = getModule(slug);
const quiz = getQuiz(slug);
const heading = t('quiz.heading', { title: m.title[lang] });
const title = `${heading} · ${m.n} ${m.title[lang]} · ${t('site.name')}`;
---

<BaseLayout
  lang={lang}
  title={title}
  description={t('quiz.lead')}
  nav="modules"
  family={m.family}
  altPath={modulePath(other, slug, 'quiz')}
  narrowFooter
>
  <ModuleHeader lang={lang} module={m} current="quiz" />
  <ModuleMain slug={slug} kind="quiz" section="quiz">
    <SectionIntro
      eyebrow={t('module.section', { n: SECTION_KEYS.length, total: SECTION_KEYS.length })}
      title={heading}
      lead={t('quiz.lead')}
    />
    {quiz ? (
      <Quiz
        client:load
        lang={lang}
        mode="quiz"
        slug={slug}
        questions={quiz.quiz.map((q) => viewQuestion(q, lang))}
      />
    ) : (
      <ComingSoon lang={lang} variant="quiz" />
    )}
    <Pager lang={lang} module={m} current="quiz" />
  </ModuleMain>
</BaseLayout>
