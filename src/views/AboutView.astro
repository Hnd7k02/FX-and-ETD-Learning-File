---
/**
 * About & Methodology page (DE /ueber/, EN /en/about/).
 * Every number comes from the calculation core (src/lib/fx), the Riskometer data
 * (src/data/fx/riskometer.json, if built) or the source files (src/content/sources*.md).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArrowIcon from '@/components/layout/ArrowIcon.astro';
import ResetProgress from '@/components/islands/ResetProgress';
import { FAMILIES, MODULES, type Family } from '@/data/modules';
import { about as dict } from '@/i18n/dict/about';
import { common } from '@/i18n/dict/common';
import { levels, LEVEL_COLORS, LEVEL_KEYS, type LevelIndex } from '@/i18n/dict/levels';
import { aboutPath, homePath, modulePath, riskometerPath } from '@/i18n/routes';
import { translator, type Lang } from '@/i18n/types';
import { EXAMPLE as E, EXAMPLE_FORWARD, EXAMPLE_LABEL, EXAMPLE_STRIKE } from '@/lib/fx/example';
import { DAY_COUNT } from '@/lib/fx/daycount';
import { forwardMoneyMarket, forwardPoints } from '@/lib/fx/forward';
import { gkPrice } from '@/lib/fx/vanilla';
import {
  fmtDate,
  fmtMillions,
  fmtMoney,
  fmtNumber,
  fmtPct,
  fmtPctValue,
  fmtPips,
  fmtRate,
  pipSize,
} from '@/lib/format';
import { collectSources, splitBilingual, urlHost } from '@/lib/sources';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'de' ? 'en' : 'de';
const t = translator(dict, lang);
const tc = translator(common, lang);
const tl = translator(levels, lang);

/* ---------- Running example (calculation core) ---------- */
const fwdMm = forwardMoneyMarket(E.spot, E.rd, E.rf, E.mmDays);
const points = forwardPoints(EXAMPLE_FORWARD, E.spot, E.pair);
const mmDiffPips = Math.abs(fwdMm - EXAMPLE_FORWARD) / pipSize(E.pair);
const call = gkPrice(E.spot, EXAMPLE_STRIKE, E.T, E.vol, E.rd, E.rf, 'call');
const callPips = call / pipSize(E.pair);
const callMoney = call * E.notional;
const notional = fmtMillions(E.notional, E.base, lang);

const tiles = [
  { label: t('about.example.spot'), value: fmtRate(E.spot, E.pair) },
  {
    label: t('about.example.forward', { months: E.months }),
    value: fmtRate(EXAMPLE_FORWARD, E.pair, 5),
  },
  { label: t('about.example.strike'), value: fmtRate(EXAMPLE_STRIKE, E.pair) },
  { label: t('about.example.premium'), value: fmtMoney(callMoney, E.quote, lang) },
];

const exampleRows: Array<{ qty: string; sym?: string; value: string; note: string }> = [
  { qty: t('about.example.pair'), value: E.pair, note: t('about.example.pairNote') },
  { qty: t('about.example.spot'), sym: '<i>S</i>', value: fmtRate(E.spot, E.pair), note: t('about.example.input') },
  {
    qty: t('about.example.rd'),
    sym: '<i>r</i><sub>d</sub>',
    value: fmtPct(E.rd, lang, 1),
    note: t('about.example.input'),
  },
  {
    qty: t('about.example.rf'),
    sym: '<i>r</i><sub>f</sub>',
    value: fmtPct(E.rf, lang, 1),
    note: t('about.example.input'),
  },
  {
    qty: t('about.example.term'),
    sym: '<i>T</i>',
    value: t('about.example.termValue', { months: E.months }),
    note: t('about.example.termNote', { T: fmtNumber(E.T, lang, { digits: 2 }), days: E.mmDays }),
  },
  { qty: t('about.example.vol'), sym: '<i>σ</i>', value: fmtPct(E.vol, lang, 0), note: t('about.example.input') },
  {
    qty: t('about.example.fwdCont'),
    sym: '<i>F</i>',
    value: fmtRate(EXAMPLE_FORWARD, E.pair, 5),
    note: '<i>S</i> · e<sup>(<i>r</i><sub>d</sub> − <i>r</i><sub>f</sub>)<i>T</i></sup>',
  },
  {
    qty: t('about.example.fwdMm'),
    value: fmtRate(fwdMm, E.pair, 5),
    note: '<i>S</i> · (1 + <i>r</i><sub>d</sub><i>t</i>) / (1 + <i>r</i><sub>f</sub><i>t</i>)',
  },
  {
    qty: t('about.example.points'),
    value: t('about.example.pointsValue', { pips: fmtPips(points, lang, 1) }),
    note: '(<i>F</i> − <i>S</i>) / pip',
  },
  {
    qty: t('about.example.strike'),
    sym: '<i>K</i>',
    value: fmtRate(EXAMPLE_STRIKE, E.pair),
    note: t('about.example.calcStrike'),
  },
  {
    qty: t('about.example.notional'),
    value: notional,
    note: t('about.example.input'),
  },
  { qty: t('about.example.position'), value: t('about.example.positionValue'), note: '' },
  {
    qty: t('about.example.premium'),
    sym: '<i>C</i>',
    value: t('about.example.premiumValue', {
      pips: fmtPips(callPips, lang, 1),
      money: fmtMoney(callMoney, E.quote, lang),
    }),
    note: t('about.example.calcPremium'),
  },
];

/* ---------- Riskometer method (generated JSON if present, else documented constants) ---------- */
interface RmThresholds {
  p20: number;
  p60: number;
  p85: number;
  p97: number;
  max: number;
  maxDate: string;
}
interface RmJson {
  asOf?: string;
  method?: {
    window?: number;
    annualisation?: number;
    since?: string;
    percentiles?: number[];
    peakRange?: { before?: number; after?: number };
  };
  pairs?: Record<string, { thresholds?: RmThresholds }>;
}
const rmFiles = import.meta.glob<{ default: RmJson }>('../data/fx/riskometer.json', {
  eager: true,
});
const rm: RmJson | null = Object.values(rmFiles)[0]?.default ?? null;
const num = (x: unknown, d: number) => (typeof x === 'number' && Number.isFinite(x) ? x : d);
const pctl =
  Array.isArray(rm?.method?.percentiles) && rm!.method!.percentiles!.length === 4
    ? rm!.method!.percentiles!
    : [20, 60, 85, 97];
const method = {
  window: num(rm?.method?.window, 21),
  ann: num(rm?.method?.annualisation, 252),
  since: typeof rm?.method?.since === 'string' ? rm.method.since : '2006-01-01',
  p: pctl as [number, number, number, number],
  before: num(rm?.method?.peakRange?.before, 10),
  after: num(rm?.method?.peakRange?.after, 60),
};
const sinceLabel = fmtDate(method.since, lang);
const sinceYear = method.since.slice(0, 4);
const bounds = [0, ...method.p, 100];
const levelBands = ([1, 2, 3, 4, 5] as LevelIndex[]).map((lv, i) => {
  const from = bounds[i]!;
  const to = bounds[i + 1]!;
  const range =
    i === 0
      ? t('about.risk.range.first', { to })
      : i === 4
        ? t('about.risk.range.last', { from })
        : t('about.risk.range.mid', { from, to });
  return {
    label: tl(LEVEL_KEYS[i]!),
    color: LEVEL_COLORS[lv],
    range,
    share: t('about.risk.share', { pct: fmtPctValue(to - from, lang, 0) }),
  };
});
const PAIR_ORDER = ['EUR/CHF', 'USD/CHF', 'EUR/USD', 'USD/JPY'];
const thresholdRows = rm?.pairs
  ? PAIR_ORDER.filter((p) => rm.pairs![p]?.thresholds).map((p) => ({
      pair: p,
      th: rm.pairs![p]!.thresholds!,
    }))
  : [];

/* ---------- Conventions ---------- */
const act360 = Object.entries(DAY_COUNT)
  .filter(([, dc]) => dc === 'ACT/360')
  .map(([c]) => c)
  .join(', ');
const act365 = Object.entries(DAY_COUNT)
  .filter(([, dc]) => dc === 'ACT/365')
  .map(([c]) => c)
  .join(', ');
const conventions = [
  {
    topic: t('about.conv.numbers'),
    rule: t('about.conv.numbersRule'),
    sample: fmtNumber(1234567.5, lang, { digits: 2 }),
  },
  { topic: t('about.conv.percent'), rule: t('about.conv.percentRule'), sample: fmtPct(0.125, lang, 1) },
  {
    topic: t('about.conv.minus'),
    rule: t('about.conv.minusRule'),
    sample: fmtNumber(-0.42, lang, { digits: 2 }),
  },
  {
    topic: t('about.conv.rates'),
    rule: t('about.conv.ratesRule'),
    sample: `${fmtRate(1.23456, 'EUR/USD')} · ${fmtRate(123.456, 'USD/JPY')}`,
  },
  { topic: t('about.conv.pip'), rule: t('about.conv.pipRule'), sample: `${pipSize('EUR/USD')} · ${pipSize('USD/JPY')}` },
  { topic: t('about.conv.quote'), rule: t('about.conv.quoteRule'), sample: 'Base/Quote' },
  {
    topic: t('about.conv.mm'),
    rule: t('about.conv.mmRule', { act360, act365 }),
    sample: `${E.mmDays} / 360 = ${fmtNumber(E.mmDays / 360, lang, { digits: 4 })}`,
  },
  {
    topic: t('about.conv.model'),
    rule: t('about.conv.modelRule'),
    sample: `${fmtNumber(E.T * 365, lang, { digits: 2 })} / 365 = ${fmtNumber(E.T, lang, { digits: 2 })}`,
  },
  { topic: t('about.conv.value'), rule: t('about.conv.valueRule'), sample: 'T+2' },
  { topic: t('about.conv.greeks'), rule: t('about.conv.greeksRule'), sample: 'Δ Γ ν Θ ρ' },
];

/* ---------- Sources ---------- */
const mainSrc = import.meta.glob<string>('../content/sources.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const fragSrc = import.meta.glob<string>('../content/sources/*.md', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const sources = collectSources(
  [
    ...Object.entries(mainSrc),
    ...Object.entries(fragSrc).sort(([a], [b]) => a.localeCompare(b)),
  ].map(([file, markdown]) => ({ file, markdown })),
);

/* ---------- Families and TOC ---------- */
const families = (Object.keys(FAMILIES) as Family[]).map((f) => ({
  key: f,
  label: FAMILIES[f].label[lang],
  modules: MODULES.filter((m) => m.family === f),
}));

const toc = [
  { id: 'was', en: 'what', label: t('about.what.h') },
  { id: 'beispiel', en: 'example', label: t('about.example.h') },
  { id: 'modelle', en: 'models', label: t('about.models.h') },
  { id: 'riskometer', en: 'riskometer', label: t('about.risk.h') },
  { id: 'konventionen', en: 'conventions', label: t('about.conv.h') },
  { id: 'quellen', en: 'sources', label: t('about.sources.h') },
  { id: 'credits', en: 'credits', label: t('about.credits.h') },
].map((s) => ({ id: lang === 'de' ? s.id : s.en, label: s.label }));
const sid = (i: number) => toc[i]!.id;
---

<BaseLayout
  lang={lang}
  title={t('about.title')}
  description={t('about.description')}
  nav="about"
  altPath={aboutPath(other)}
>
  <div class="ab-page">
    <header class="ab-head">
      <div class="container-module ab-head-inner">
        <nav aria-label={tc('a11y.breadcrumb')} class="ab-crumbs">
          <a href={homePath(lang)}>{tc('module.home')}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="ab-crumb-current">{t('about.crumb')}</span>
        </nav>
        <div class="ab-chips">
          <span class="chip chip-neutral">{t('about.chip')}</span>
        </div>
        <h1 class="h1-module">{t('about.h1')}</h1>
        <p class="lead ab-lead">{t('about.lead')}</p>
        <aside class="ab-disclaimer" aria-labelledby="ab-disclaimer-title">
          <span class="ab-disclaimer-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 22 22">
              <circle cx="11" cy="11" r="9.25" fill="none" stroke="currentColor" stroke-width="1.8"
              ></circle>
              <path d="M11 10v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              ></path>
              <circle cx="11" cy="6.6" r="1.2" fill="currentColor"></circle>
            </svg>
          </span>
          <div>
            <p class="ab-disclaimer-title" id="ab-disclaimer-title">{t('about.disclaimer')}</p>
            <p class="ab-disclaimer-text">{t('about.disclaimerText')}</p>
          </div>
        </aside>
      </div>
    </header>

    <div class="container-module ab-layout">
      <nav class="ab-toc" aria-label={t('about.toc')}>
        <p class="ab-toc-title">{t('about.toc')}</p>
        <ol>
          {
            toc.map((s, i) => (
              <li>
                <a href={`#${s.id}`} data-toc={s.id}>
                  <span class="ab-toc-n mono">{String(i + 1).padStart(2, '0')}</span>
                  <span>{s.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <main class="ab-main">
        {/* 01 What */}
        <section class="ab-section" id={sid(0)} aria-labelledby={`${sid(0)}-h`}>
          <p class="ab-num mono" aria-hidden="true">01</p>
          <h2 class="h2" id={`${sid(0)}-h`}>{t('about.what.h')}</h2>
          <div class="ab-prose">
            <p>{t('about.what.p1')}</p>
            <p>{t('about.what.p2')}</p>
            <p>{t('about.what.p3')}</p>
          </div>
          <div class="ab-not">
            <p class="ab-not-title">{t('about.what.notH')}</p>
            <ul>
              <li>{t('about.what.not1')}</li>
              <li>{t('about.what.not2')}</li>
              <li>{t('about.what.not3')}</li>
              <li>{t('about.what.not4')}</li>
            </ul>
          </div>
          <h3 class="ab-h3">{t('about.what.familiesH')}</h3>
          <ul class="ab-families">
            {
              families.map((f) => (
                <li class="ab-family card" data-family={f.key}>
                  <span class="chip chip-family">{f.label}</span>
                  <ul>
                    {f.modules.map((m) => (
                      <li>
                        <a href={modulePath(lang, m.slug, '1')}>
                          <span class="mono ab-family-n">{m.n}</span>
                          <span>{m.title[lang]}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ul>
        </section>

        {/* 02 Example */}
        <section class="ab-section" id={sid(1)} aria-labelledby={`${sid(1)}-h`}>
          <p class="ab-num mono" aria-hidden="true">02</p>
          <h2 class="h2" id={`${sid(1)}-h`}>{t('about.example.h')}</h2>
          <p class="ab-lead2">{t('about.example.lead', { months: E.months, notional })}</p>
          <div class="ab-case card-hero">
            <div class="ab-tiles">
              {
                tiles.map((tile, i) => (
                  <div class:list={['ab-tile', i === 3 && 'ab-tile--dark']}>
                    <span class="ab-tile-label">{tile.label}</span>
                    <span class="ab-tile-value mono">{tile.value}</span>
                  </div>
                ))
              }
            </div>
            <div class="ab-table-wrap">
              <table class="ab-table">
                <caption class="sr-only">{t('about.example.tableCaption')}</caption>
                <thead>
                  <tr>
                    <th scope="col">{t('about.example.colQty')}</th>
                    <th scope="col">{t('about.example.colValue')}</th>
                    <th scope="col">{t('about.example.colNote')}</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    exampleRows.map((r) => (
                      <tr>
                        <th scope="row">
                          {r.qty}
                          {r.sym && <span class="ab-sym math" set:html={r.sym} />}
                        </th>
                        <td class="mono ab-val">{r.value}</td>
                        <td class="ab-note math-mixed" set:html={r.note} />
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <p class="ab-example-label">
              <span class="dot" aria-hidden="true"></span>
              {EXAMPLE_LABEL[lang]}
            </p>
          </div>
        </section>

        {/* 03 Models */}
        <section class="ab-section" id={sid(2)} aria-labelledby={`${sid(2)}-h`}>
          <p class="ab-num mono" aria-hidden="true">03</p>
          <h2 class="h2" id={`${sid(2)}-h`}>{t('about.models.h')}</h2>
          <p class="ab-lead2">{t('about.models.lead')}</p>

          <div class="ab-models">
            <article class="ab-model card" data-family="linear">
              {modChip('02-forward', '2')}
              <h3 class="ab-h3">{t('about.models.fwd.h')}</h3>
              <p>{t('about.models.fwd.p', { diff: fmtPips(mmDiffPips, lang, 1) })}</p>
              <div class="formula">
                <span
                  ><i>F</i> = <i>S</i> · (1 + <i>r</i><sub>d</sub> <i>t</i><sub>d</sub>) / (1 + <i
                    >r</i
                  ><sub>f</sub> <i>t</i><sub>f</sub>)</span
                >
              </div>
              <div class="formula formula--accent">
                <span
                  ><i>F</i> = <i>S</i> · e<sup>(<i>r</i><sub>d</sub> − <i>r</i><sub>f</sub>) <i>T</i
                    ></sup
                  ></span
                >
              </div>
            </article>

            <article class="ab-model card" data-family="options">
              {modChip('04-vanilla-options', '4')}
              <h3 class="ab-h3">{t('about.models.gk.h')}</h3>
              <p>{t('about.models.gk.p')}</p>
              <div class="formula formula--accent">
                <span
                  ><i>C</i> = <i>S</i> e<sup>−<i>r</i><sub>f</sub><i>T</i></sup> <i>N</i>(<i>d</i
                  ><sub>1</sub>) − <i>K</i> e<sup>−<i>r</i><sub>d</sub><i>T</i></sup> <i>N</i>(<i
                    >d</i
                  ><sub>2</sub>)</span
                >
                <span class="formula-sub"
                  ><i>d</i><sub>1,2</sub> = [ln(<i>S</i>/<i>K</i>) + (<i>r</i><sub>d</sub> − <i
                    >r</i
                  ><sub>f</sub> ± ½<i>σ</i><sup>2</sup>) <i>T</i>] / (<i>σ</i>√<i>T</i>)</span
                >
              </div>
            </article>

            <article class="ab-model card" data-family="options">
              {modChip('04-vanilla-options', '4')}
              <h3 class="ab-h3">{t('about.models.b76.h')}</h3>
              <p>{t('about.models.b76.p')}</p>
              <div class="formula formula--accent">
                <span
                  ><i>C</i> = DF<sub>d</sub> · [<i>F</i> <i>N</i>(<i>d</i><sub>1</sub>) − <i>K</i>
                  <i>N</i>(<i>d</i><sub>2</sub>)]</span
                >
                <span class="formula-sub"
                  ><i>d</i><sub>1,2</sub> = [ln(<i>F</i>/<i>K</i>) ± ½<i>σ</i><sup>2</sup><i>T</i>]
                  / (<i>σ</i>√<i>T</i>), DF<sub>d</sub> = e<sup>−<i>r</i><sub>d</sub><i>T</i></sup
                  ></span
                >
              </div>
            </article>

            <article class="ab-model card" data-family="options">
              {modChip('05-greeks', '2')}
              <h3 class="ab-h3">{t('about.models.greeks.h')}</h3>
              <p>{t('about.models.greeks.p')}</p>
              <div class="formula">
                <span
                  >Δ = e<sup>−<i>r</i><sub>f</sub><i>T</i></sup> <i>N</i>(<i>d</i><sub>1</sub>), Γ =
                  e<sup>−<i>r</i><sub>f</sub><i>T</i></sup> <i>φ</i>(<i>d</i><sub>1</sub>) / (<i>S</i
                  > <i>σ</i>√<i>T</i>)</span
                >
              </div>
              <div class="formula formula--accent">
                <span
                  ><i>C</i> − <i>P</i> = DF<sub>d</sub> · (<i>F</i> − <i>K</i>)</span
                >
              </div>
            </article>

            <article class="ab-model card" data-family="options">
              {modChip('06-combos-smile', '4')}
              <h3 class="ab-h3">{t('about.models.smile.h')}</h3>
              <p>{t('about.models.smile.p')}</p>
              <div class="formula formula--accent">
                <span
                  ><i>σ</i>(Δ) = ATM − 2 · RR · (Δ − 0.5) + 16 · BF · (Δ − 0.5)<sup>2</sup></span
                >
              </div>
            </article>

            <article class="ab-model card" data-family="exotics">
              {modChip('07-barrier-binary', '2')}
              <h3 class="ab-h3">{t('about.models.exotics.h')}</h3>
              <p>{t('about.models.exotics.p')}</p>
              <div class="formula">
                <span
                  >Digital<sub>call</sub> = e<sup>−<i>r</i><sub>d</sub><i>T</i></sup> <i>N</i>(<i
                    >d</i
                  ><sub>2</sub>)</span
                >
              </div>
              <div class="formula formula--accent">
                <span>Knock-in + Knock-out = Vanilla</span>
              </div>
            </article>

            <article class="ab-model ab-model--wide card" data-family="exotics">
              {modChip('08-structured-products', '2')}
              <h3 class="ab-h3">{t('about.models.mc.h')}</h3>
              <p>{t('about.models.mc.p')}</p>
              <div class="formula formula--accent">
                <span
                  ><i>S</i><sub><i>t</i>+Δ<i>t</i></sub> = <i>S</i><sub><i>t</i></sub> · exp[(<i>r</i
                  ><sub>d</sub> − <i>r</i><sub>f</sub> − ½<i>σ</i><sup>2</sup>) Δ<i>t</i> + <i>σ</i
                  >√Δ<i>t</i> · <i>Z</i>], Δ<i>t</i> = 1/365</span
                >
              </div>
              <ul class="ab-mc-list">
                <li>{t('about.models.mc.seed')}</li>
                <li>{t('about.models.mc.anti')}</li>
                <li>
                  {t('about.models.mc.bgk')}
                  <span class="formula ab-inline-formula"
                    ><span
                      ><i>B</i> → <i>B</i> · e<sup>±0.5826 · <i>σ</i> · √Δ<i>t</i></sup></span
                    ></span
                  >
                </li>
                <li>{t('about.models.mc.out')}</li>
              </ul>
            </article>
          </div>
          <p class="ab-small">{t('about.models.normal')}</p>
        </section>

        {/* 04 Riskometer */}
        <section class="ab-section" id={sid(3)} aria-labelledby={`${sid(3)}-h`}>
          <p class="ab-num mono" aria-hidden="true">04</p>
          <h2 class="h2" id={`${sid(3)}-h`}>{t('about.risk.h')}</h2>
